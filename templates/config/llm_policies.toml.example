# Copy to the consumer repository as .github/docmethis-fix/llm_policies.toml and select a
# model/policy supported by the private runtime release.
# JSON is validated locally by default. Set structured_output_mode = "guided_json" only for a supported endpoint/model.

[fix.example]
model = "provider/model"
max_attempts = 3
timeout_seconds = 30.0
token_budget = 8000
prompt_variant = "compact"
structured_output_mode = "json_prompted"

[fix.example.generation_options]
temperature = 0.0
max_tokens = 8000

# Replace each model placeholder with an ID served by the selected API profile.
[fix.responses]
model = "replace-with-responses-model-id"
max_attempts = 3
timeout_seconds = 30.0
token_budget = 8000
prompt_variant = "compact"
structured_output_mode = "json_prompted"

[fix.responses.generation_options]
max_output_tokens = 2000

[fix.anthropic]
model = "replace-with-anthropic-model-id"
max_attempts = 3
timeout_seconds = 30.0
token_budget = 8000
prompt_variant = "compact"
structured_output_mode = "json_prompted"

[fix.anthropic.generation_options]
max_tokens = 2000

[fix.gemini]
model = "replace-with-gemini-model-id"
max_attempts = 3
timeout_seconds = 30.0
token_budget = 8000
prompt_variant = "compact"
structured_output_mode = "json_prompted"

[fix.gemini.generation_options.generationConfig]
maxOutputTokens = 2000
