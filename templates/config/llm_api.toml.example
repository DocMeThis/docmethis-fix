# Copy to the consumer repository as .github/docmethis-fix/llm_api.toml and replace the
# placeholder values. Never commit provider API keys.

[example]
provider = "openai_compatible"
base_url = "https://api.example.invalid/v1"
api_key_env_var = "DOCMETHIS_PROVIDER_API_KEY"
request_timeout_cap_seconds = 30.0
connect_timeout_seconds = 10.0
read_timeout_seconds = 30.0
pool_timeout_seconds = 10.0
http_max_connections = 10
http_max_keepalive_connections = 5
http_keepalive_expiry_seconds = 30.0

# Select this profile with a Responses policy (max_output_tokens, not max_tokens).
[responses]
provider = "openai_responses"
base_url = "https://opencode.ai/inference/go/v1"
api_key_env_var = "OPENCODE_API_KEY"
request_timeout_cap_seconds = 30.0
connect_timeout_seconds = 10.0
read_timeout_seconds = 30.0
pool_timeout_seconds = 10.0
http_max_connections = 10
http_max_keepalive_connections = 5
http_keepalive_expiry_seconds = 30.0

[responses.extra_headers]
x-opencode-session = "{session_id}"

[anthropic]
provider = "anthropic"
base_url = "https://api.anthropic.com/v1"
api_key_env_var = "ANTHROPIC_API_KEY"
request_timeout_cap_seconds = 30.0
connect_timeout_seconds = 10.0
read_timeout_seconds = 30.0
pool_timeout_seconds = 10.0
http_max_connections = 10
http_max_keepalive_connections = 5
http_keepalive_expiry_seconds = 30.0

[gemini]
provider = "gemini"
base_url = "https://generativelanguage.googleapis.com/v1beta"
api_key_env_var = "GEMINI_API_KEY"
request_timeout_cap_seconds = 30.0
connect_timeout_seconds = 10.0
read_timeout_seconds = 30.0
pool_timeout_seconds = 10.0
http_max_connections = 10
http_max_keepalive_connections = 5
http_keepalive_expiry_seconds = 30.0
